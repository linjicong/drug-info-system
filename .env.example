# TiDB Cloud Serverless 数据库连接（必填）
# 格式: mysql://<user>:<password>@<host>:4000/<dbname>?ssl={"rejectUnauthorized":true}
# Vercel: Dashboard -> Settings -> Environment Variables
# CloudBase 云托管: 服务 -> 版本配置 -> 环境变量
DATABASE_URL=

# 定时任务鉴权密钥
# Vercel Cron / GitHub Actions 会以此值作为 Authorization: Bearer 调用 /api/cron/trigger
# 需与数据库 unified_scheduler_config.cron_secret 一致（或数据库该字段为 null 跳过鉴权）
CRON_SECRET=

# 环境标识（Vercel / 容器运行时自动注入 production；本地开发设 development）
NODE_ENV=development

# ===== CloudBase 云托管部署说明（容器运行时，无需写入 .env）=====
# 以下变量由 CloudBase 平台自动注入，不要手动配置：
#   PORT       监听端口（Dockerfile 默认 3000，平台注入时自动覆盖）
#   HOSTNAME   Dockerfile 已固定 0.0.0.0（容器外可访问的必要条件）
# 抓取源 API 地址为可选覆盖项（代码已内置默认值，通常无需配置）：
#   PUBONLN_API_URL / PUBONLN_API_REFERER / DRUG_API_URL / DRUG_DETAIL_API_URL
# 定时任务改用 GitHub Actions（见 .github/workflows/cloudbase-cron.yml），
# 需在仓库配置 Secrets: DEPLOY_URL（云托管域名）、CRON_SECRET。
# 完整部署步骤见 DEPLOY-CLOUDBASE.md。

# ===== 以下仅一次性数据迁移时使用，迁移完成后可删除 =====
# 源 Supabase PostgreSQL 连接串，供 scripts/migrate-supabase-to-tidb.ts 读取历史数据
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler（端口 5432）
# 不要用 Transaction pooler（6543），不支持 prepared statement；末尾必须加 ?sslmode=require
# 格式: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
