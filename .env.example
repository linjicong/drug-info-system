# TiDB Cloud Serverless 数据库连接（必填）
# 格式: mysql://<user>:<password>@<host>:4000/<dbname>?ssl={"rejectUnauthorized":true}
# 在 Vercel Dashboard -> Settings -> Environment Variables 配置
DATABASE_URL=

# 定时任务鉴权密钥
# Vercel Cron Jobs 会自动以此值作为 Authorization: Bearer 调用 /api/cron/trigger
# 需与数据库 unified_scheduler_config.cron_secret 一致（或数据库该字段为 null 跳过鉴权）
CRON_SECRET=

# 环境标识（Vercel 自动注入；本地开发设 development）
NODE_ENV=development

# ===== 以下仅一次性数据迁移时使用，迁移完成后可删除 =====
# 源 Supabase PostgreSQL 连接串，供 scripts/migrate-supabase-to-tidb.ts 读取历史数据
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler（端口 5432）
# 不要用 Transaction pooler（6543），不支持 prepared statement；末尾必须加 ?sslmode=require
# 格式: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
