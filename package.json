{
  "name": "drug-info-system",
  "version": "0.1.2",
  "private": true,
  "description": "药品信息管理系统：抓取、合并与查询政府药品采购平台数据",
  "author": "drug-info-system",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "next start",
    "ts-check": "tsc -p tsconfig.json",
    "migrate:data": "tsx --env-file=.env scripts/migrate-supabase-to-tidb.ts",
    "add:index": "tsx --env-file=.env scripts/add-prefix-index.ts",
    "create:progress-table": "tsx --env-file=.env scripts/create-task-progress-table.ts",
    "create:usage-events": "tsx --env-file=.env scripts/create-usage-events-table.ts",
    "scrape:runner": "tsx --env-file=.env scripts/scrape-runner.ts",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "next build && node scripts/assemble-desktop.mjs && node scripts/desktop-build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tidbcloud/serverless": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-dev-inspector/babel-plugin": "^2.0.1",
    "@react-dev-inspector/middleware": "^2.0.1",
    "@supabase/supabase-js": "2.95.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "mysql2": "^3.11.0",
    "only-allow": "^1.2.2",
    "pg": "^8.22.0",
    "qiniu": "^7.15.2",
    "react-dev-inspector": "^2.0.1",
    "shadcn": "latest",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
